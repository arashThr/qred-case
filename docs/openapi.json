{
  "openapi": "3.1.0",
  "info": {
    "title": "Qred Card Dashboard API",
    "version": "1.0.0",
    "description": "Backend for the mobile card home view. Money is always { minor, currency } in minor units (öre)."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/companies": {
      "get": {
        "operationId": "listCompanies",
        "summary": "Companies the caller is a member of (company switcher)",
        "responses": {
          "200": {
            "description": "Companies",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyList"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies/{companyId}/dashboard": {
      "get": {
        "operationId": "getDashboard",
        "summary": "Everything the card home screen needs, read as one snapshot",
        "parameters": [
          {
            "in": "path",
            "name": "companyId",
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "cmp_1"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dashboard"
                },
                "examples": {
                  "pendingCard": {
                    "summary": "Card awaiting activation, invoice due",
                    "value": {
                      "asOf": "2026-09-27T10:00:00Z",
                      "company": {
                        "id": "cmp_1",
                        "name": "Company AB"
                      },
                      "companies": [
                        {
                          "id": "cmp_1",
                          "name": "Company AB"
                        },
                        {
                          "id": "cmp_2",
                          "name": "Other AB"
                        }
                      ],
                      "invoiceDue": {
                        "id": "inv_1",
                        "status": "due",
                        "dueDate": "2026-09-30",
                        "amount": {
                          "minor": 312000,
                          "currency": "SEK"
                        }
                      },
                      "card": {
                        "id": "crd_1",
                        "status": "pending_activation",
                        "brand": "VISA",
                        "last4": "4242",
                        "activatedAt": null
                      },
                      "spend": {
                        "limit": {
                          "minor": 1000000,
                          "currency": "SEK"
                        },
                        "used": {
                          "minor": 540000,
                          "currency": "SEK"
                        },
                        "remaining": {
                          "minor": 460000,
                          "currency": "SEK"
                        },
                        "basis": "user_set_limit"
                      },
                      "transactions": {
                        "latest": [
                          {
                            "id": "txn_057",
                            "merchantName": "ICA Maxi",
                            "amount": {
                              "minor": 12900,
                              "currency": "SEK"
                            },
                            "occurredAt": "2026-09-27T08:03:00Z",
                            "status": "pending"
                          },
                          {
                            "id": "txn_056",
                            "merchantName": "SJ",
                            "amount": {
                              "minor": 89500,
                              "currency": "SEK"
                            },
                            "occurredAt": "2026-09-26T16:40:00Z",
                            "status": "settled"
                          },
                          {
                            "id": "txn_055",
                            "merchantName": "Clas Ohlson",
                            "amount": {
                              "minor": 24900,
                              "currency": "SEK"
                            },
                            "occurredAt": "2026-09-26T11:15:00Z",
                            "status": "settled"
                          }
                        ],
                        "totalCount": 57,
                        "remainingCount": 54
                      },
                      "actions": {
                        "activateCard": {
                          "enabled": true
                        }
                      }
                    }
                  },
                  "activeCardNothingDue": {
                    "summary": "Active card, no invoice due",
                    "value": {
                      "asOf": "2026-09-27T10:00:00Z",
                      "company": {
                        "id": "cmp_2",
                        "name": "Other AB"
                      },
                      "companies": [
                        {
                          "id": "cmp_1",
                          "name": "Company AB"
                        },
                        {
                          "id": "cmp_2",
                          "name": "Other AB"
                        }
                      ],
                      "invoiceDue": null,
                      "card": {
                        "id": "crd_2",
                        "status": "active",
                        "brand": "VISA",
                        "last4": "1881",
                        "activatedAt": "2026-06-02T09:12:00Z"
                      },
                      "spend": {
                        "limit": {
                          "minor": 2000000,
                          "currency": "SEK"
                        },
                        "used": {
                          "minor": 45000,
                          "currency": "SEK"
                        },
                        "remaining": {
                          "minor": 1955000,
                          "currency": "SEK"
                        },
                        "basis": "user_set_limit"
                      },
                      "transactions": {
                        "latest": [
                          {
                            "id": "txn_101",
                            "merchantName": "Kjell & Company",
                            "amount": {
                              "minor": 45000,
                              "currency": "SEK"
                            },
                            "occurredAt": "2026-09-25T13:20:00Z",
                            "status": "settled"
                          }
                        ],
                        "totalCount": 1,
                        "remainingCount": 0
                      },
                      "actions": {
                        "activateCard": {
                          "enabled": false
                        }
                      }
                    }
                  },
                  "empty": {
                    "summary": "New company: no card, limit or transactions",
                    "value": {
                      "asOf": "2026-09-27T10:00:00Z",
                      "company": {
                        "id": "cmp_1",
                        "name": "Company AB"
                      },
                      "companies": [
                        {
                          "id": "cmp_1",
                          "name": "Company AB"
                        },
                        {
                          "id": "cmp_2",
                          "name": "Other AB"
                        }
                      ],
                      "invoiceDue": null,
                      "card": null,
                      "spend": null,
                      "transactions": {
                        "latest": [],
                        "totalCount": 0,
                        "remainingCount": 0
                      },
                      "actions": {
                        "activateCard": {
                          "enabled": false
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller is not a member of the company",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies/{companyId}/cards/{cardId}": {
      "get": {
        "operationId": "getCard",
        "summary": "A card of the company",
        "parameters": [
          {
            "in": "path",
            "name": "companyId",
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "cmp_1"
            },
            "required": true
          },
          {
            "in": "path",
            "name": "cardId",
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "crd_1"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Card",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller is not a member of the company",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Card not found in this company",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies/{companyId}/cards/{cardId}/activate": {
      "post": {
        "operationId": "activateCard",
        "summary": "Activate a card. Idempotent: an active card returns 200 unchanged.",
        "parameters": [
          {
            "in": "path",
            "name": "companyId",
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "cmp_1"
            },
            "required": true
          },
          {
            "in": "path",
            "name": "cardId",
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "crd_1"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "The activated card",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Card"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller is not a member of the company",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Card not found in this company",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Card cannot be activated (blocked)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies/{companyId}/invoices/{invoiceId}": {
      "get": {
        "operationId": "getInvoice",
        "summary": "An invoice of the company",
        "parameters": [
          {
            "in": "path",
            "name": "companyId",
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "cmp_1"
            },
            "required": true
          },
          {
            "in": "path",
            "name": "invoiceId",
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "inv_1"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Invoice",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller is not a member of the company",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Invoice not found in this company",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies/{companyId}/transactions": {
      "get": {
        "operationId": "listTransactions",
        "summary": "All transactions of the company, newest first, cursor paginated",
        "parameters": [
          {
            "in": "path",
            "name": "companyId",
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "cmp_1"
            },
            "required": true
          },
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "description": "Opaque cursor from a previous page; omit for the first page",
              "type": "string",
              "minLength": 1
            },
            "description": "Opaque cursor from a previous page; omit for the first page"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of transactions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid limit or cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Caller is not a member of the company",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CompanyList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Company"
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "Company": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "example": {
          "id": "cmp_1",
          "name": "Company AB"
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "example": {
          "error": {
            "code": "COMPANY_FORBIDDEN",
            "message": "Not a member of this company"
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "UNAUTHENTICATED",
          "COMPANY_FORBIDDEN",
          "CARD_NOT_FOUND",
          "INVOICE_NOT_FOUND",
          "ROUTE_NOT_FOUND",
          "CARD_NOT_ACTIVATABLE",
          "INTERNAL_ERROR"
        ]
      },
      "Dashboard": {
        "type": "object",
        "properties": {
          "asOf": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "Point in time all figures were read at"
          },
          "company": {
            "$ref": "#/components/schemas/Company"
          },
          "companies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Company"
            },
            "description": "Companies for the switcher"
          },
          "invoiceDue": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/InvoiceDue"
              },
              {
                "type": "null"
              }
            ]
          },
          "card": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Card"
              },
              {
                "type": "null"
              }
            ],
            "description": "Most recently issued card; null if none"
          },
          "spend": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Spend"
              },
              {
                "type": "null"
              }
            ],
            "description": "null if the company has no limit"
          },
          "transactions": {
            "type": "object",
            "properties": {
              "latest": {
                "maxItems": 3,
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Transaction"
                },
                "description": "Newest first, all statuses"
              },
              "totalCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "remainingCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "totalCount - latest.length"
              }
            },
            "required": [
              "latest",
              "totalCount",
              "remainingCount"
            ],
            "additionalProperties": false
          },
          "actions": {
            "type": "object",
            "properties": {
              "activateCard": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "enabled"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "activateCard"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "asOf",
          "company",
          "companies",
          "invoiceDue",
          "card",
          "spend",
          "transactions",
          "actions"
        ],
        "additionalProperties": false
      },
      "InvoiceDue": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/InvoiceStatus"
          },
          "dueDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          }
        },
        "required": [
          "id",
          "status",
          "dueDate",
          "amount"
        ],
        "additionalProperties": false,
        "description": "Oldest unpaid invoice. null hides the banner."
      },
      "InvoiceStatus": {
        "type": "string",
        "enum": [
          "due",
          "overdue",
          "paid"
        ]
      },
      "Money": {
        "type": "object",
        "properties": {
          "minor": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Amount in minor units (öre). 5 400 kr = 540000."
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "description": "ISO 4217 currency code",
            "example": "SEK"
          }
        },
        "required": [
          "minor",
          "currency"
        ],
        "additionalProperties": false
      },
      "Card": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/CardStatus"
          },
          "brand": {
            "type": "string",
            "enum": [
              "VISA"
            ]
          },
          "last4": {
            "type": "string",
            "pattern": "^\\d{4}$"
          },
          "activatedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "status",
          "brand",
          "last4",
          "activatedAt"
        ],
        "additionalProperties": false,
        "example": {
          "id": "crd_1",
          "status": "pending_activation",
          "brand": "VISA",
          "last4": "4242",
          "activatedAt": null
        }
      },
      "CardStatus": {
        "type": "string",
        "enum": [
          "pending_activation",
          "active",
          "blocked"
        ]
      },
      "Spend": {
        "type": "object",
        "properties": {
          "limit": {
            "$ref": "#/components/schemas/Money"
          },
          "used": {
            "$ref": "#/components/schemas/Money"
          },
          "remaining": {
            "$ref": "#/components/schemas/Money"
          },
          "basis": {
            "type": "string",
            "enum": [
              "user_set_limit",
              "credit_limit"
            ]
          }
        },
        "required": [
          "limit",
          "used",
          "remaining",
          "basis"
        ],
        "additionalProperties": false,
        "description": "Spend in the current billing period against the limit. Not the invoice amount."
      },
      "Transaction": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "merchantName": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "status": {
            "$ref": "#/components/schemas/TransactionStatus"
          }
        },
        "required": [
          "id",
          "merchantName",
          "amount",
          "occurredAt",
          "status"
        ],
        "additionalProperties": false,
        "description": "A ledger entry. amount.minor > 0 is spend, < 0 is a refund.",
        "example": {
          "id": "txn_057",
